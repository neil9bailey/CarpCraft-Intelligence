# CarpCraft Intelligence local development environment

APP_ENV=local
APP_NAME=CarpCraft Intelligence
API_VERSION=0.1.0
API_HOST=127.0.0.1
API_PORT=8000

# PostgreSQL / PostGIS / pgvector ready
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=carpcraft
POSTGRES_USER=carpcraft
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://carpcraft:change-me-local-only@localhost:5432/carpcraft

# Auth scaffold only. Replace before any shared environment.
AUTH_MODE=local
AUTH_REQUIRED=false
JWT_SECRET=replace-with-local-development-secret
JWT_ISSUER=carpcraft-local
JWT_AUDIENCE=carpcraft-mobile
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOCAL_DEV_USER_ID=local-dev-user

# Microsoft Entra ID / DIIAC tenant.
# Public tenant identifiers are not secrets. Client IDs/audiences must be created per app registration.
ENTRA_TENANT_ID=67f8be6c-07da-4a7c-bb0a-d6bcb38cd6da
ENTRA_DEFAULT_TENANT=diiac.io
ENTRA_AUDIENCE=api://9f0ac07a-2cce-4e4b-b74b-41264c6594e3
ENTRA_AUDIENCES=api://9f0ac07a-2cce-4e4b-b74b-41264c6594e3,9f0ac07a-2cce-4e4b-b74b-41264c6594e3
ENTRA_ISSUER=
ENTRA_JWKS_URI=
ENTRA_CLIENT_ID=96e02813-75a8-4fef-a8f2-d1c8b41234c6
ENTRA_API_SCOPE=api://9f0ac07a-2cce-4e4b-b74b-41264c6594e3/access_as_user
ENTRA_REDIRECT_URL=com.carpcraft.intelligence://oauthredirect

# Future provider integrations. Leave empty unless explicitly configured.
OPEN_METEO_BASE_URL=https://api.open-meteo.com
WEATHER_PRIMARY_PROVIDER=open_meteo
WEATHER_SECONDARY_PROVIDER=met_office
MET_OFFICE_API_KEY=
MET_OFFICE_BASE_URL=https://data.hub.api.metoffice.gov.uk
OPENAI_API_KEY=
OPENAI_MODEL=
AI_EXPLANATIONS_ENABLED=false
ANGLINGAI_API_KEY=
ANGLINGAI_BASE_URL=https://anglingai.co.uk/api/v1

# Google Maps / geolocation
GOOGLE_MAPS_API_KEY=
# Optional backend Places key for venue source enrichment. Prefer a server/IP-restricted key here,
# separate from the Android package-restricted Maps SDK key above.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com

# Privacy defaults
DEFAULT_PRIVACY_LEVEL=private
ENABLE_PRECISE_LOCATION=false
ENABLE_PHOTO_UPLOADS=false
